---
import type {CollectionEntry} from 'astro:content';
import {type Lang, localePath, pick, t} from '../i18n';

interface Props {
  lang: Lang;
  book: CollectionEntry<'books'>;
}

const {lang, book} = Astro.props;
const b = book.data;
const s = t(lang).books;
const page = localePath(lang, `/books/${book.id}/`);
const pdf = b.files.find((f) => f.format === 'PDF');
---

<article class="card book-card">
  <a class="cover" href={page} tabindex="-1" aria-hidden="true">
    {
      b.cover ? (
        <img src={b.cover} alt="" width="1600" height="686" loading="lazy" decoding="async" />
      ) : (
        <span class="cover-text" lang={b.language}>
          {b.title[b.language]}
        </span>
      )
    }
  </a>
  <div class="body">
    <p class="meta">
      {b.year}
      {b.status === 'in-progress' && <span class="tag tag-accent">{s.status['in-progress']}</span>}
      {lang !== b.language && <span class="tag">{s.langNames[b.language]}</span>}
    </p>
    <h3><a href={page}>{pick(b.title, lang)}</a></h3>
    <p class="muted">{pick(b.subtitle, lang)}</p>
    <div class="links">
      <a href={b.site}>{s.readOnline}</a>
      {pdf && <a href={pdf.url}>PDF</a>}
    </div>
  </div>
</article>

<style>
  .book-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cover {
    display: block;
    text-decoration: none;
    aspect-ratio: 16 / 7;
    background: var(--accent-soft);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-text {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--accent);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--accent) 6%, transparent) 14px 15px);
  }

  .body {
    padding: 1.25rem;
  }

  .body h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .body h3 a:hover {
    color: var(--accent);
  }

  .meta .tag {
    margin-left: 0.4rem;
  }
</style>
