---
import Base from '../layouts/Base.astro';
import {localePath, t} from '../i18n';

// GitHub Pages serves one 404.html for every address. It is English; under /ru/ a script
// swaps in the Russian text, so each version of the site stays in its own language.
const en = t('en');
const ru = t('ru');
---

<Base lang="en" path="/404/" title={en.notFound.title}>
  <div class="container page-head" data-lang="en">
    <h1>{en.notFound.title}</h1>
    <p>{en.notFound.text}</p>
    <p>
      <a href={localePath('en', '/')}>{en.notFound.home}</a> · <a href={localePath('en', '/books/')}>{en.nav.books}</a>
    </p>
  </div>
  <div class="container page-head" data-lang="ru" lang="ru" hidden>
    <h1>{ru.notFound.title}</h1>
    <p>{ru.notFound.text}</p>
    <p>
      <a href={localePath('ru', '/')}>{ru.notFound.home}</a> · <a href={localePath('ru', '/books/')}>{ru.nav.books}</a>
    </p>
  </div>
  <script is:inline define:vars={{ruTitle: `${ru.notFound.title} — ${ru.siteName}`}}>
    if (location.pathname.startsWith('/ru/')) {
      document.querySelector('[data-lang="en"]').hidden = true;
      document.querySelector('[data-lang="ru"]').hidden = false;
      document.documentElement.lang = 'ru';
      document.title = ruTitle;
    }
  </script>
</Base>
